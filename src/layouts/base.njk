<!doctype html>
<html lang="te">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {% set metaTitle = (title + ' | NewsPulse') if title and title != 'Home' else 'NewsPulse' %}
    {% set metaDescription = description or site.description %}
    <meta name="description" content="{{ metaDescription }}">
    <title>{{ metaTitle }}</title>
    <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="NewsPulse">
    <meta property="og:title" content="{{ metaTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}">
    <meta property="og:locale" content="te_IN">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ metaTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="theme-color" content="#0b1020">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230b1020'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='19' font-weight='700' fill='%23ffffff' text-anchor='middle'%3EN%3C/text%3E%3C/svg%3E">
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"WebSite","name":"NewsPulse","url":"{{ site.baseUrl }}/","inLanguage":["te","en"]}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Telugu:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-i18n="skipToContent">ప్రధాన కంటెంట్‌కు వెళ్లండి</a>
    <div class="page-shell">
      <header class="topbar">
        <div class="brand-wrap">
          <span class="brand-mark">N</span>
          <div>
            <p class="brand-kicker">Live updates</p>
            <h1><a href="{{ '/' | url }}">NewsPulse</a></h1>
          </div>
        </div>

        <div class="top-actions">
          <label class="country-picker-wrap" aria-label="Select country">
            <span data-i18n="countryLabel">దేశం</span>
            <select id="country-selector" class="country-picker">
              <option value="all" data-i18n="allCountries">అన్ని దేశాలు</option>
              <option value="global" data-i18n="global">గ్లోబల్</option>
              <option value="uk">United Kingdom</option>
              <option value="us">United States</option>
              <option value="india">India</option>
              <option value="andhra-pradesh">Andhra Pradesh</option>
              <option value="telangana">Telangana</option>
              <option value="hyderabad">Hyderabad</option>
              <option value="australia">Australia</option>
              <option value="uae">UAE</option>
            </select>
          </label>

          <label class="country-picker-wrap" aria-label="Select language">
            <span data-i18n="languageLabel">భాష</span>
            <select id="language-selector" class="country-picker">
              <option value="en">English</option>
              <option value="te" selected>తెలుగు</option>
            </select>
          </label>

          <label class="search-box" aria-label="Search news">
            <span>⌕</span>
            <input id="news-search" type="search" placeholder="వార్తలను వెతకండి" data-i18n-placeholder="searchPlaceholder" />
          </label>

          <button class="nav-toggle" aria-label="Toggle navigation" aria-controls="main-nav" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>

          <nav id="main-nav" class="main-nav" aria-label="Main navigation">
            <a href="{{ '/' | url }}" data-i18n="navHome">హోమ్</a>
            <a href="{{ '/categories/' | url }}" data-i18n="navCategories">వర్గాలు</a>
            <a href="{{ '/countries/' | url }}" data-i18n="navCountries">దేశాలు</a>
            <a href="{{ '/categories/daily-briefing/' | url }}" data-i18n="navDailyBriefing">రోజువారీ నివేదిక</a>
            <a href="{{ '/categories/politics/' | url }}" data-i18n="navPolitics">రాజకీయాలు</a>
            <a href="{{ '/categories/world/' | url }}" data-i18n="navWorld">ప్రపంచం</a>
            <a href="{{ '/categories/business/' | url }}" data-i18n="navBusiness">వ్యాపారం</a>
            <a href="{{ '/categories/technology/' | url }}" data-i18n="navTechnology">సాంకేతికత</a>
            <a href="{{ '/categories/ai-trends/' | url }}" data-i18n="navAi">AI &amp; ట్రెండ్స్</a>
            <a href="{{ '/categories/sports/' | url }}" data-i18n="navSports">క్రీడలు</a>
            <a href="{{ '/categories/favourites/' | url }}" data-i18n="navFavourites">ఇష్టమైనవి</a>
          </nav>
        </div>
      </header>

      <div class="ticker-wrap" aria-label="Breaking news ticker">
        <div class="ticker-label">LIVE</div>
        {% set liveCategories = ['politics','world','business','technology','ai-trends','sports','entertainment','science','health'] %}
        {% set tickerTitles = [] %}
        {% for cat in liveCategories %}
          {% set item = collections[cat][0] %}
          {% if item and item.data.title not in tickerTitles %}
            {% set _pushed = tickerTitles.push(item.data.title) %}
          {% endif %}
        {% endfor %}
        <div class="ticker-track">
          {% for newsTitle in tickerTitles %}
            <span>{{ newsTitle }}</span>
          {% endfor %}
          {% for newsTitle in tickerTitles %}
            <span>{{ newsTitle }}</span>
          {% endfor %}
        </div>
      </div>

      <main class="content-wrap" id="main-content">
        {{ content | safe }}
      </main>

      <footer class="site-footer">
        <p class="footer-line"><span data-i18n="footerText">Eleventy తో రూపొందించబడింది • పబ్లిక్ RSS ఫీడ్లు ఆటోమేటిక్గా తాజాకరించబడతాయి • చివరిగా అప్‌డేట్ చేయబడింది</span> <span data-last-updated="{{ site.lastUpdated }}">ఇప్పుడే</span></p>
      </footer>
    </div>

