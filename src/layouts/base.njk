<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Live news dashboard for politics, business, technology, sports, and more.">
    <title>{{ title or 'News Aggregator' }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div class="brand-wrap">
          <span class="brand-mark">N</span>
          <div>
            <p class="brand-kicker">Live updates</p>
            <h1><a href="{{ '/' | url }}">NewsPulse</a></h1>
          </div>
        </div>

        <div class="top-actions">
          <label class="country-picker-wrap" aria-label="Select country">
            <span>Country</span>
            <select id="country-selector" class="country-picker">
              <option value="all">All countries</option>
              <option value="global">Global</option>
              <option value="uk">United Kingdom</option>
              <option value="us">United States</option>
              <option value="india">India</option>
              <option value="australia">Australia</option>
              <option value="uae">UAE</option>
            </select>
          </label>

          <label class="search-box" aria-label="Search news">
            <span>⌕</span>
            <input id="news-search" type="search" placeholder="Search stories" />
          </label>

          <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>

          <nav class="main-nav" aria-label="Main navigation">
            <a href="{{ '/' | url }}">Home</a>
            <a href="{{ '/categories/' | url }}">Categories</a>
            <a href="{{ '/categories/politics/' | url }}">Politics</a>
            <a href="{{ '/categories/world/' | url }}">World</a>
            <a href="{{ '/categories/business/' | url }}">Business</a>
            <a href="{{ '/categories/technology/' | url }}">Technology</a>
            <a href="{{ '/categories/ai-trends/' | url }}">AI &amp; Trends</a>
            <a href="{{ '/categories/sports/' | url }}">Sports</a>
            <a href="{{ '/categories/favourites/' | url }}">Favourites</a>
          </nav>
        </div>
      </header>

      <div class="ticker-wrap" aria-label="Breaking news ticker">
        <div class="ticker-label">LIVE</div>
        <div class="ticker-track">
          {% set liveCategories = ['politics','world','business','technology','ai-trends','sports','entertainment','science','health'] %}
          {% for cat in liveCategories %}
            {% set item = collections[cat][0] %}
            {% if item %}
              <span>{{ item.data.title }}</span>
            {% endif %}
          {% endfor %}
          {% for cat in liveCategories %}
            {% set item = collections[cat][0] %}
            {% if item %}
              <span>{{ item.data.title }}</span>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <main class="content-wrap">
        {{ content | safe }}
      </main>

      <footer class="site-footer">
        <p>Generated with Eleventy • Public RSS feeds refreshed automatically</p>
      </footer>
    </div>

    <script>
      const STORAGE_KEY = 'newspulse-favourites';

      function getFavourites() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch (error) {
          return [];
        }
      }

      function setFavourites(items) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      }

      function saveFavourite(story) {
        const items = getFavourites();
        const exists = items.some((item) => item.url === story.url);
        const next = exists ? items.filter((item) => item.url !== story.url) : [...items, story];
        setFavourites(next);
        updateFavouriteButtons();
        renderFavouritePage();
      }

      function updateFavouriteButtons() {
        const items = getFavourites();
        const savedUrls = new Set(items.map((item) => item.url));

        document.querySelectorAll('.favorite-toggle').forEach((button) => {
          const url = button.dataset.url;
          const saved = savedUrls.has(url);
          button.textContent = saved ? 'Saved' : 'Save';
          button.classList.toggle('is-saved', saved);
          button.setAttribute('aria-pressed', saved ? 'true' : 'false');
        });
      }

      function renderFavouritePage() {
        const container = document.querySelector('[data-favourites-root]');
        if (!container) return;

        const favourites = getFavourites();
        const list = document.querySelector('[data-favourites-list]');
        const empty = document.querySelector('[data-favourites-empty]');

        if (!list || !empty) return;

        if (favourites.length === 0) {
          list.innerHTML = '';
          empty.hidden = false;
          return;
        }

        empty.hidden = true;
        list.innerHTML = favourites.map((story) => `
          <li>
            <a href="${story.url}" target="_blank" rel="noreferrer"><strong>${story.title}</strong></a>
            <div class="meta">${story.date || ''} • ${story.source || 'Saved article'}</div>
          </li>
        `).join('');
      }

      document.addEventListener('click', (event) => {
        const button = event.target.closest('.favorite-toggle');
        if (!button) return;

        const story = {
          title: button.dataset.title || 'Saved story',
          url: button.dataset.url,
          source: button.dataset.source || 'Saved article',
          date: button.dataset.date || ''
        };

        saveFavourite(story);
      });

      const searchInput = document.getElementById('news-search');
      const searchableItems = document.querySelectorAll('[data-searchable]');
      const navToggle = document.querySelector('.nav-toggle');
      const mainNav = document.querySelector('.main-nav');
      const countrySelector = document.getElementById('country-selector');
      let currentCountry = localStorage.getItem('news-country') || 'all';
      let currentQuery = '';

      function inferCountryFromText(text) {
        const value = (text || '').toLowerCase();
        if (/(uk|united kingdom|britain|england|scotland|wales|london|parliament|government)/.test(value)) return 'uk';
        if (/(us|united states|usa|washington|california|texas|new york|federal)/.test(value)) return 'us';
        if (/(india|mumbai|delhi|modi|bengaluru|hyderabad)/.test(value)) return 'india';
        if (/(australia|sydney|melbourne|canberra|australian)/.test(value)) return 'australia';
        if (/(uae|dubai|abu dhabi|emirates|united arab)/.test(value)) return 'uae';
        return 'global';
      }

      function applyUiFilters() {
        searchableItems.forEach((item) => {
          const explicitCountry = (item.dataset.country || '').toLowerCase();
          const inferredCountry = inferCountryFromText(item.dataset.searchable || item.textContent || '');
          const country = explicitCountry || inferredCountry;
          const matchesCountry = currentCountry === 'all' || currentCountry === 'global' || country === currentCountry || country === 'global';
          const text = (item.dataset.searchable || item.textContent || '').toLowerCase();
          const matchesQuery = !currentQuery || text.includes(currentQuery);
          item.style.display = matchesCountry && matchesQuery ? '' : 'none';
        });
      }

      if (countrySelector) {
        const savedCountry = localStorage.getItem('news-country') || 'all';
        currentCountry = savedCountry;
        countrySelector.value = savedCountry;

        countrySelector.addEventListener('change', (event) => {
          currentCountry = event.target.value || 'all';
          localStorage.setItem('news-country', currentCountry);
          applyUiFilters();
        });
      }

      if (searchInput && searchableItems.length) {
        searchInput.addEventListener('input', (event) => {
          currentQuery = event.target.value.trim().toLowerCase();
          applyUiFilters();
        });
      }

      applyUiFilters();

      if (navToggle && mainNav) {
        navToggle.addEventListener('click', () => {
          const isOpen = mainNav.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', String(isOpen));
        });

        mainNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            mainNav.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
          });
        });
      }

      updateFavouriteButtons();
      renderFavouritePage();
    </script>
  </body>
</html>
