      let currentLanguage = localStorage.getItem('site-language') || 'te';

      function currentTranslations() {
        return translations[currentLanguage] || translations.te;
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function applyLanguage(lang) {
        const normalized = translations[lang] ? lang : 'te';
        const selected = translations[normalized];
        currentLanguage = normalized;
        document.documentElement.lang = normalized;

        document.querySelectorAll('[data-i18n]').forEach((el) => {
          if (selected[el.dataset.i18n]) {
            el.textContent = selected[el.dataset.i18n];
          }
        });

        document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
          if (selected[el.dataset.i18nPlaceholder]) {
            el.placeholder = selected[el.dataset.i18nPlaceholder];
          }
        });

        const brand = document.querySelector('.brand-kicker');
        if (brand) brand.textContent = selected.liveUpdates;

        const brandTitle = document.querySelector('.brand-wrap h1 a');
        if (brandTitle) brandTitle.textContent = selected.newsPulse;

        localStorage.setItem('site-language', normalized);

        // Re-render text that is injected by scripts rather than templates.
        updateFavouriteButtons();
        renderFavouritePage();
        addRegionBadges();
        updateLastUpdatedLabel();
      }

      const languageSelector = document.getElementById('language-selector');
      if (languageSelector) {
        const savedLanguage = localStorage.getItem('site-language') || 'te';
        languageSelector.value = savedLanguage;
        languageSelector.addEventListener('change', (event) => applyLanguage(event.target.value || 'te'));
      }

      const countryLabels = {
        global: 'Global',
        uk: 'United Kingdom',
        us: 'United States',
        india: 'India',
        'andhra-pradesh': 'Andhra Pradesh',
        telangana: 'Telangana',
        hyderabad: 'Hyderabad',
        australia: 'Australia',
        uae: 'UAE'
      };

      function formatCountryLabel(value) {
        const country = String(value || 'global').trim().toLowerCase();
        const localized = localizedRegionLabels[currentLanguage] || {};
        if (localized[country]) return localized[country];
        if (countryLabels[country]) return countryLabels[country];
        return country.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' ');
      }

      function addRegionBadges() {
        document.querySelectorAll('[data-country]').forEach((card) => {
          const country = (card.dataset.country || 'global').toLowerCase();
          const label = formatCountryLabel(country);

          const existing = card.querySelector('.story-region-badge');
          if (existing) {
            existing.textContent = label;
            return;
          }

          const meta = card.querySelector('.story-meta');
          if (!meta) return;

          const badge = document.createElement('span');
          badge.className = 'story-region-badge';
          badge.textContent = label;
          meta.appendChild(badge);
        });
      }

      function updateLastUpdatedLabel() {
        const el = document.querySelector('[data-last-updated]');
        if (!el) return;

        const iso = el.dataset.lastUpdated;
        if (!iso) return;

        const t = currentTranslations();
        const updatedAt = new Date(iso);
        const diffMinutes = Math.max(0, Math.round((Date.now() - updatedAt.getTime()) / 60000));
        el.textContent = diffMinutes <= 1 ? t.justNow : `${diffMinutes} ${t.minutesAgo}`;
      }

      function getFavourites() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        } catch (error) {
          return [];
        }
      }

      function setFavourites(items) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      }

      function saveFavourite(story) {
        const items = getFavourites();
        const exists = items.some((item) => item.url === story.url);
        const next = exists ? items.filter((item) => item.url !== story.url) : [...items, story];
        setFavourites(next);
        updateFavouriteButtons();
        renderFavouritePage();
      }

      function updateFavouriteButtons() {
        const items = getFavourites();
        const savedUrls = new Set(items.map((item) => item.url));
        const t = currentTranslations();

        document.querySelectorAll('.favorite-toggle').forEach((button) => {
          const url = button.dataset.url;
          const saved = savedUrls.has(url);
          const label = saved ? t.savedLabel : t.saveLabel;
          const title = button.dataset.title;

          button.textContent = label;
          button.classList.toggle('is-saved', saved);
          button.setAttribute('aria-pressed', saved ? 'true' : 'false');
          button.setAttribute('aria-label', title ? `${label}: ${title}` : label);
        });
      }

      function renderFavouritePage() {
        const container = document.querySelector('[data-favourites-root]');
        if (!container) return;

        const favourites = getFavourites();
        const list = document.querySelector('[data-favourites-list]');
        const empty = document.querySelector('[data-favourites-empty]');

        if (!list || !empty) return;

        if (favourites.length === 0) {
          list.innerHTML = '';
          empty.hidden = false;
          return;
        }

        empty.hidden = true;
        list.innerHTML = favourites.map((story) => `
          <li>
            <a href="${escapeHtml(story.url)}" target="_blank" rel="noreferrer noopener"><strong>${escapeHtml(story.title)}</strong></a>
            <div class="meta">${escapeHtml(story.date || '')} • ${escapeHtml(story.source || 'Saved article')}</div>
          </li>
        `).join('');
      }

      document.addEventListener('click', (event) => {
        const button = event.target.closest('.favorite-toggle');
        if (!button) return;

        const story = {
          title: button.dataset.title || 'Saved story',
          url: button.dataset.url,
          source: button.dataset.source || 'Saved article',
          date: button.dataset.date || ''
        };

        saveFavourite(story);
      });

      const searchInput = document.getElementById('news-search');
      const searchableItems = document.querySelectorAll('[data-searchable]');
      const navToggle = document.querySelector('.nav-toggle');
      const mainNav = document.querySelector('.main-nav');
      const countrySelector = document.getElementById('country-selector');
      let currentCountry = localStorage.getItem('news-country') || 'all';
      let currentQuery = '';

      function normalizeCountry(value) {
        const country = String(value || '').trim().toLowerCase();
        if (!country || country === 'all') return 'all';

        const aliases = {
          uk: 'uk',
          'united kingdom': 'uk',
          britain: 'uk',
          england: 'uk',
          scotland: 'uk',
          wales: 'uk',
          'northern ireland': 'uk',
          london: 'uk',
          parliament: 'uk',
          government: 'uk',
          us: 'us',
          usa: 'us',
          'united states': 'us',
          washington: 'us',
          california: 'us',
          texas: 'us',
          'new york': 'us',
          federal: 'us',
          india: 'india',
          mumbai: 'india',
          delhi: 'india',
          modi: 'india',
          bengaluru: 'india',
          'andhra pradesh': 'andhra-pradesh',
          andhra: 'andhra-pradesh',
          vijayawada: 'andhra-pradesh',
          amaravati: 'andhra-pradesh',
          telangana: 'telangana',
          warangal: 'telangana',
          hyderabad: 'hyderabad',
          secunderabad: 'hyderabad',
          australia: 'australia',
          sydney: 'australia',
          melbourne: 'australia',
          canberra: 'australia',
          australian: 'australia',
          uae: 'uae',
          dubai: 'uae',
          'abu dhabi': 'uae',
          emirates: 'uae',
          'united arab': 'uae',
          global: 'global'
        };

        return aliases[country] || country;
      }

      function inferCountryFromText(text) {
        const value = (text || '').toLowerCase();
        if (/(uk|united kingdom|britain|england|scotland|wales|london|parliament|government)/.test(value)) return 'uk';
        if (/(us|united states|usa|washington|california|texas|new york|federal)/.test(value)) return 'us';
        if (/(hyderabad|secunderabad|charminar|ghmc)/.test(value)) return 'hyderabad';
        if (/(telangana|warangal|nizamabad)/.test(value)) return 'telangana';
        if (/(andhra pradesh|andhra|vijayawada|visakhapatnam|amaravati|guntur)/.test(value)) return 'andhra-pradesh';
        if (/(india|mumbai|delhi|modi|bengaluru)/.test(value)) return 'india';
        if (/(australia|sydney|melbourne|canberra|australian)/.test(value)) return 'australia';
        if (/(uae|dubai|abu dhabi|emirates|united arab)/.test(value)) return 'uae';
        return 'global';
      }

      function matchesSelectedCountry(itemCountry, selectedCountry) {
        const item = normalizeCountry(itemCountry);
        const selected = normalizeCountry(selectedCountry);

        if (selected === 'all') return true;
        if (selected === 'global') return item === 'global';
        if (item === 'global') return false;

        return item === selected;
      }

      function applyUiFilters() {
        searchableItems.forEach((item) => {
          const explicitCountry = normalizeCountry(item.dataset.country || '');
          const inferredCountry = normalizeCountry(inferCountryFromText(item.dataset.searchable || item.textContent || ''));
          const country = explicitCountry !== 'all' ? explicitCountry : inferredCountry;
          const matchesCountry = matchesSelectedCountry(country, currentCountry);
          const text = (item.dataset.searchable || item.textContent || '').toLowerCase();
          const matchesQuery = !currentQuery || text.includes(currentQuery);
          item.style.display = matchesCountry && matchesQuery ? '' : 'none';
        });
      }

      if (countrySelector) {
        const savedCountry = localStorage.getItem('news-country') || 'all';
        currentCountry = savedCountry;
        countrySelector.value = savedCountry;

        countrySelector.addEventListener('change', (event) => {
          currentCountry = event.target.value || 'all';
          localStorage.setItem('news-country', currentCountry);
          applyUiFilters();
        });
      }

      if (searchInput && searchableItems.length) {
        searchInput.addEventListener('input', (event) => {
          currentQuery = event.target.value.trim().toLowerCase();
          applyUiFilters();
        });
      }

      applyUiFilters();

      if (navToggle && mainNav) {
        navToggle.addEventListener('click', () => {
          const isOpen = mainNav.classList.toggle('open');
          navToggle.setAttribute('aria-expanded', String(isOpen));
        });

        mainNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            mainNav.classList.remove('open');
            navToggle.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // Apply the stored language last so every renderer and DOM node exists.
      applyLanguage(localStorage.getItem('site-language') || 'te');
    </script>
  </body>
</html>
