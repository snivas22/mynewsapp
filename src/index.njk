---
layout: base.njk
title: Home
---

<section class="masthead-row" aria-label="Newsroom masthead">
  <div class="edition-tag" data-i18n="globalEdition">గ్లోబల్ ఎడిషన్</div>
  <div class="masthead-date">{{ site.currentDateLabel }}</div>
  <div class="live-bell" data-i18n="liveDesk">లైవ్ డెస్క్</div>
</section>

<section class="regional-desk" aria-label="Regional desk overview">
  <div class="regional-head">
    <p class="eyebrow" data-i18n="regionalDesk">ప్రాంతీయ డెస్క్</p>
    <h3 data-i18n="indiaStateUpdates">ఇండియా మరియు రాష్ట్ర అప్‌డేట్లు</h3>
  </div>

  <div class="region-grid">
    {% set regionalLinks = [
      { slug: 'india', label: 'India', count: collections.india | length },
      { slug: 'andhra-pradesh', label: 'Andhra Pradesh', count: collections['andhra-pradesh'] | length },
      { slug: 'telangana', label: 'Telangana', count: collections.telangana | length },
      { slug: 'hyderabad', label: 'Hyderabad', count: collections.hyderabad | length },
      { slug: 'daily-briefing', label: 'Daily briefing', count: collections['daily-briefing'] | length }
    ] %}

    {% for region in regionalLinks %}
      <a class="region-link" href="{{ ('/countries/' + region.slug + '/') | url if region.slug in ['india','andhra-pradesh','telangana','hyderabad'] else ('/categories/' + region.slug + '/') | url }}">
        <span class="region-name">{{ region.label }}</span>
        <strong>{{ region.count }} stories</strong>
      </a>
    {% endfor %}
  </div>
</section>

<section class="hero-panel">
  <div class="lead-story">
    <p class="eyebrow">Top story</p>
    {% set featured = collections.politics[0] %}
    {% if featured %}
      <h2><a href="{{ featured.url }}">{{ featured.data.title }}</a></h2>
      <p class="hero-copy">{{ featured.templateContent | striptags | truncate(220) }}</p>
      <div class="story-meta-row">
        <span>{{ featured.date | readableDate }}</span>
        <span>{{ featured.data.source }}</span>
      </div>
    {% else %}
      <h2>Fresh stories from across the world.</h2>
      <p class="hero-copy">Track the latest reporting in politics, business, technology, sports, health, and more with a clean, readable dashboard.</p>
    {% endif %}
    <div class="hero-actions">
      <a class="primary-btn" href="{{ '/categories/' | url }}">Explore categories</a>
      <a class="secondary-btn" href="{{ '/categories/politics/' | url }}">Top story</a>
    </div>
  </div>

  <div class="lead-visual" aria-label="Lead image treatment">
    <div class="visual-overlay">
      <span data-i18n="liveReport">లైవ్ రిపోర్ట్</span>
      <strong data-i18n="globalBriefing">గ్లోబల్ బ్రీఫింగ్</strong>
    </div>
  </div>

  <div class="status-box">
    <span class="status-dot"></span>
    <div>
      <strong data-i18n="feedActive">RSS స్ట్రీమ్ క్రియాశీలంగా ఉంది</strong>
      <small data-i18n="feedSchedule">షెడ్యూల్ ప్రకారం ఆటోమేటిక్గా అప్‌డేట్ అవుతోంది</small>
    </div>
  </div>
</section>

<section class="breaking-stack">
  {% set categories = [ 'politics','world','business','technology','ai-trends' ] %}
  {% for cat in categories %}
    {% set items = collections[cat] %}
    {% if items and items.length > 0 %}
      <article class="headline-box">
        <span class="mini-label {{ cat }}">{{ cat | replace('-', ' ') | title }}</span>
        <a href="{{ items[0].url }}">{{ items[0].data.title }}</a>
      </article>
    {% endif %}
  {% endfor %}
</section>

<section class="feature-strip" aria-label="Featured stories">
  <article class="feature-tile feature-tile-large">
    <div class="feature-image image-energy"></div>
    <div class="feature-content">
      <span class="feature-kicker" data-i18n="spotlight">స్పాట్లైట్</span>
      <h3 data-i18n="featureEnergyTitle">ప్రపంచ ఎనర్జీ మరియు విధాన మార్పులు తదుపరి ఆర్థిక చక్రాన్ని మళ్లీ రూపొందిస్తున్నాయి.</h3>
      <p data-i18n="featureEnergyText">వారంలో అత్యంత ముఖ్యమైన కథనాలపై విశ్లేషణ, మార్కెట్ చ movements మరియు అంతర్జాతీయ స్పందన.</p>
    </div>
  </article>

  <article class="feature-tile">
    <div class="feature-image image-markets"></div>
    <div class="feature-content">
      <span class="feature-kicker" data-i18n="markets">మార్కెట్స్</span>
      <h3 data-i18n="featureMarketsTitle">పెట్టుబడిదారుల దృష్టి AI, రుణ మరియు సరఫరా గొలుసు స్థితిస్థాపనపై ఉంది.</h3>
    </div>
  </article>

  <article class="feature-tile">
    <div class="feature-image image-culture"></div>
    <div class="feature-content">
      <span class="feature-kicker" data-i18n="culture">సంస్కృతి</span>
      <h3 data-i18n="featureCultureTitle">స్ట్రీమింగ్, క్రీడలు మరియు పాప్‌సంస్కృతి రికార్డు ప్రేక్షకులను ఆకర్షిస్తున్నాయి.</h3>
    </div>
  </article>
</section>

<section class="editorial-break" aria-label="Live desk update">
  <div class="live-desk">
    <p class="eyebrow" data-i18n="liveDesk">లైవ్ డెస్క్</p>
    <h3 data-i18n="liveDescription">తదుపరి హెడ్డ్లైన్ వస్తే ముందే మీకు కావలసిన నివేదిక.</h3>
  </div>
  <div class="live-jump">
    <span class="breaking-badge" data-i18n="breaking">బ్రేకింగ్</span>
    <p data-i18n="breakingText">ద్రవ్యోల్బణం మరియు విధాన మార్పులు మార్కెట్లు మరియు ఫెడరల్ చర్చలపై కొనసాగుతున్న అస్తవ్యస్తిని పెంచుతున్నాయి.</p>
  </div>
</section>

<section class="quick-take-grid" aria-label="Quick takes">
  <article class="quick-take">
    <span class="mini-label politics">Politics</span>
    <h4>Policy pressure builds around public funding and regional response.</h4>
  </article>
  <article class="quick-take">
    <span class="mini-label world">World</span>
    <h4>International leaders respond to supply-chain and climate pressure points.</h4>
  </article>
  <article class="quick-take">
    <span class="mini-label technology">Technology</span>
    <h4>AI investment and regulation continue to dominate global boardroom conversations.</h4>
  </article>
</section>

{% set categories = ['politics','world','business','technology','ai-trends','sports','entertainment','science','health','favourites'] %}

<section class="stats-row">
  {% for cat in categories %}
    {% if cat == 'politics' %}{% set label = 'Politics' %}{% elseif cat == 'world' %}{% set label = 'World' %}{% elseif cat == 'business' %}{% set label = 'Business' %}{% elseif cat == 'technology' %}{% set label = 'Technology' %}{% elseif cat == 'ai-trends' %}{% set label = 'AI & Trends' %}{% elseif cat == 'sports' %}{% set label = 'Sports' %}{% elseif cat == 'entertainment' %}{% set label = 'Entertainment' %}{% elseif cat == 'science' %}{% set label = 'Science' %}{% elseif cat == 'health' %}{% set label = 'Health' %}{% else %}{% set label = 'Favourites' %}{% endif %}
    <div class="stat-card">
      <span>{{ label }}</span>
      <strong>{{ collections[cat] | length }}</strong>
    </div>
  {% endfor %}
</section>

<section class="category-grid">
  {% for cat in categories %}
    {% if cat == 'politics' %}{% set label = 'Politics' %}{% elseif cat == 'world' %}{% set label = 'World' %}{% elseif cat == 'business' %}{% set label = 'Business' %}{% elseif cat == 'technology' %}{% set label = 'Technology' %}{% elseif cat == 'ai-trends' %}{% set label = 'AI & Trends' %}{% elseif cat == 'sports' %}{% set label = 'Sports' %}{% elseif cat == 'entertainment' %}{% set label = 'Entertainment' %}{% elseif cat == 'science' %}{% set label = 'Science' %}{% elseif cat == 'health' %}{% set label = 'Health' %}{% else %}{% set label = 'Favourites' %}{% endif %}
    {% set items = collections[cat] %}
    <article class="category-card" style="--card-accent: var(--{{ cat }});" data-searchable="{{ cat }}{% for item in items %} {{ item.data.title }}{% endfor %}">
      <div class="category-head">
        <span class="category-tag {{ cat }}">{{ label }}</span>
        <a href="{{ ('/categories/' + cat + '/') | url }}">View all</a>
      </div>

      {% if items | length == 0 %}
        <p class="empty-state">No stories available yet.</p>
      {% else %}
        <ul class="story-list compact">
          {% for item in items.slice(0, 3) %}
            <li>
              <a href="{{ item.url }}">{{ item.data.title }}</a>
              <div class="meta">{{ item.date | readableDate }} • {{ item.data.source }}</div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </article>
  {% endfor %}
</section>
