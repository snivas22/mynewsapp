---
layout: base.njk
title: Categories
---

<section class="page-header">
  <p class="eyebrow">Browse topics</p>
  <h2>All categories</h2>
</section>

<section class="category-grid category-grid-wide">
  {% for category in site.categories %}
    {% set itemCount = collections[category.slug] | length %}
    <article class="category-card">
      <a href="{{ ('/categories/' + category.slug + '/') | url }}">
        <span class="category-tag">{{ category.label }}</span>
      </a>
      <small>{{ category.blurb }} • {{ itemCount }} live items</small>
    </article>
  {% endfor %}
</section>

<section class="page-header" style="margin-top: 2rem;">
  <p class="eyebrow">Regional coverage</p>
  <h2>Countries</h2>
</section>

<section class="category-grid category-grid-wide">
  <article class="category-card"><a href="{{ '/countries/uk/' | url }}"><span class="category-tag">United Kingdom</span></a><small>UK headlines and policy updates</small></article>
  <article class="category-card"><a href="{{ '/countries/us/' | url }}"><span class="category-tag">United States</span></a><small>US politics, economics, and policy news</small></article>
  <article class="category-card"><a href="{{ '/countries/india/' | url }}"><span class="category-tag">India</span></a><small>India-focused business and public affairs</small></article>
  <article class="category-card"><a href="{{ '/countries/australia/' | url }}"><span class="category-tag">Australia</span></a><small>Australia coverage and regional developments</small></article>
  <article class="category-card"><a href="{{ '/countries/uae/' | url }}"><span class="category-tag">UAE</span></a><small>Middle East business and geopolitics</small></article>
</section>
