---
layout: base.njk
title: Politics
---

<section class="page-header">
  <p class="eyebrow" data-i18n="liveCategoryFeed">లైవ్ కేటగిరీ ఫీడ్</p>
  <h2 data-i18n="categoryPolitics">రాజకీయాలు</h2>
</section>

<div class="story-grid">
  {% set items = collections.politics %}
  {% if items | length == 0 %}
    <div class="empty-panel" data-i18n="noStories">ఇంకా కథనాలు లేవు.</div>
  {% endif %}
  {% for item in items %}
    <article class="story-card featured-card" data-country="{{ item.data.country or 'global' }}" data-searchable="{{ item.data.title }} {{ item.data.source }} {{ item.templateContent | striptags }}">
      <div class="story-meta">
        <span class="story-source politics">{{ item.data.source }}</span>
        <span>{{ item.date | readableDate }}</span>
      </div>
      <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
      <p>{{ item.templateContent | striptags | truncate(180) }}</p>
      <div class="story-actions">
        <a class="read-more" href="{{ item.url }}" data-i18n="readArticle">కథనాన్ని చదవండి</a>
        <button class="favorite-toggle" data-url="{{ item.url }}" data-title="{{ item.data.title }}" data-source="{{ item.data.source }}" data-date="{{ item.date | readableDate }}" aria-label="Save {{ item.data.title }} to favourites" data-i18n="save">సేవ్ చేయండి</button>
      </div>
    </article>
  {% endfor %}
</div>
