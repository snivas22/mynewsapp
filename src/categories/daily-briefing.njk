---
layout: base.njk
title: Daily Briefing
---

<section class="regional-hero">
  <div class="regional-copy">
    <p class="eyebrow" data-i18n="regionalBriefing">ప్రాంతీయ నివేదిక</p>
    <h2 data-i18n="dailyBriefing">రోజువారీ నివేదిక</h2>
    <p data-i18n="dailyBriefingText">రాజకీయాలు, అభివృద్ధి, పౌర సమస్యలు మరియు వ్యాపారాలపై భారతదేశం మరియు ప్రధాన ప్రాంతాల అప్‌డేట్లు ఆటోమేటిక్గా తాజాకరించబడతాయి.</p>
  </div>

  {% set topItem = collections['daily-briefing'][0] %}
  {% if topItem %}
    <article class="regional-feature">
      <span class="mini-label">Top update</span>
      <h3><a href="{{ topItem.url }}">{{ topItem.data.title }}</a></h3>
      <p>{{ topItem.templateContent | striptags | truncate(180) }}</p>
    </article>
  {% endif %}
</section>

<div class="story-grid">
  {% set items = collections['daily-briefing'] %}
  {% if items | length == 0 %}
    <div class="empty-panel">No daily briefing stories are available yet.</div>
  {% endif %}
  {% for item in items %}
    <article class="story-card featured-card" data-country="{{ item.data.country or 'global' }}" data-searchable="{{ item.data.title }} {{ item.data.source }} {{ item.templateContent | striptags }}">
      <div class="story-meta">
        <span class="story-source politics">{{ item.data.source }}</span>
        <span>{{ item.date | readableDate }}</span>
      </div>
      <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
      <p>{{ item.templateContent | striptags | truncate(180) }}</p>
      <div class="story-actions">
        <a class="read-more" href="{{ item.url }}">Read article →</a>
        <button class="favorite-toggle" data-url="{{ item.url }}" data-title="{{ item.data.title }}" data-source="{{ item.data.source }}" data-date="{{ item.date | readableDate }}" aria-label="Save {{ item.data.title }} to favourites">Save</button>
      </div>
    </article>
  {% endfor %}
</div>
