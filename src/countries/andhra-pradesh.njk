---
layout: base.njk
title: Andhra Pradesh
---

<section class="regional-hero">
  <div class="regional-copy">
    <p class="eyebrow">Regional briefing</p>
    <h2>Andhra Pradesh</h2>
    <p>Policy, development, and state-level updates from Andhra Pradesh, brought together in one daily briefing.</p>
  </div>

  {% set topItem = collections.country_andhra-pradesh[0] %}
  {% if topItem %}
    <article class="regional-feature">
      <span class="mini-label">Top update</span>
      <h3><a href="{{ topItem.url }}">{{ topItem.data.title }}</a></h3>
      <p>{{ topItem.templateContent | striptags | truncate(180) }}</p>
    </article>
  {% endif %}
</section>

<div class="story-grid">
  {% set items = collections.country_andhra-pradesh %}
  {% if items | length == 0 %}
    <div class="empty-panel">No Andhra Pradesh stories are available yet.</div>
  {% endif %}
  {% for item in items %}
    <article class="story-card" data-country="{{ item.data.country or 'global' }}" data-searchable="{{ item.data.title }} {{ item.data.source }} {{ item.templateContent | striptags }}">
      <div class="story-meta">
        <span class="story-source politics">{{ item.data.source }}</span>
        <span>{{ item.date | readableDate }}</span>
      </div>
      <h3><a href="{{ item.url }}">{{ item.data.title }}</a></h3>
      <p>{{ item.templateContent | striptags | truncate(180) }}</p>
      <div class="story-actions">
        <a class="read-more" href="{{ item.url }}">Read article →</a>
        <button class="favorite-toggle" data-url="{{ item.url }}" data-title="{{ item.data.title }}" data-source="{{ item.data.source }}" data-date="{{ item.date | readableDate }}" aria-label="Save {{ item.data.title }} to favourites">Save</button>
      </div>
    </article>
  {% endfor %}
</div>
