---
layout: base.njk
title: Countries
---

<section class="page-header">
  <p class="eyebrow" data-i18n="regionalCoverage">ప్రాంతీయ కవర్</p>
  <h2 data-i18n="countryDashboards">దేశ డాష్‌బోర్డ్లు</h2>
</section>

<section class="category-grid category-grid-wide">
  {% for country in collections.countriesOverview %}
    <article class="category-card">
      <div class="category-head">
        <span class="category-tag">{{ country.label }}</span>
        <a href="{{ ('/countries/' + country.slug + '/') | url }}" data-i18n="viewAll">అన్నీ చూడండి</a>
      </div>
      <small>{{ country.count }} <span data-i18n="storiesAvailable">కథనాలు ఉన్నాయి</span></small>
    </article>
  {% endfor %}
</section>
